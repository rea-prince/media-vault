<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>

<VBox fx:id="deleteRoot" spacing="16.0" style="-fx-background-radius: 16;" styleClass="bg-subtle" stylesheets="@../css/fall-light.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mediavault.controllers.DeleteEntryController">
   <children>
      <VBox>
         <children>
            <Label alignment="CENTER" contentDisplay="CENTER" text="Are you sure you want to delete this entry?" textAlignment="CENTER">
               <font>
                  <Font name="System Bold" size="16.0" />
               </font>
            </Label>
            <Label alignment="CENTER" contentDisplay="CENTER" text="This change will be permanent." textAlignment="CENTER" />
         </children>
      </VBox>
      <HBox alignment="BOTTOM_RIGHT" spacing="16.0">
         <children>
            <Button defaultButton="true" mnemonicParsing="false" onAction="#deleteEntry" text="Delete" textAlignment="CENTER" HBox.hgrow="ALWAYS" />
            <Button cancelButton="true" mnemonicParsing="false" onAction="#closeView" text="Cancel" HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
   </padding>
   <effect>
      <DropShadow blurType="GAUSSIAN" height="55.0" radius="27.0" width="55.0">
         <color>
            <Color opacity="0.5" />
         </color>
      </DropShadow>
   </effect>
</VBox>
