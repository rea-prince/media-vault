<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox fx:id="episodeList" prefHeight="500.0" style="-fx-background-radius: 16;" styleClass="bg-default" stylesheets="@../css/blue-dark.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mediavault.controllers.EpisodeListController">
   <children>
      <VBox spacing="10.0">
         <children>
            <ScrollPane fitToWidth="true" styleClass="bg-default" stylesheets="@../css/blue-dark.css">
               <content>
                  <VBox fx:id="episodeContainer" prefHeight="200.0" prefWidth="300.0" spacing="8.0" />
               </content>
            </ScrollPane>
            <Region VBox.vgrow="ALWAYS" />
            <HBox spacing="8.0">
               <children>
                  <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#openAddEpisodePrompt" text="Add Episode" HBox.hgrow="ALWAYS" />
                  <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#closeView" text="Close" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
   <padding>
      <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
   </padding>
   <effect>
      <DropShadow blurType="GAUSSIAN" height="55.0" radius="27.0" width="55.0" />
   </effect>
</HBox>
